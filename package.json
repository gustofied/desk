{
  "name": "desk",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://desk.adamsioud.com",
  "type": "module",
  "bin": {
    "desk": "./cli/desk"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:data": "node scripts/refresh-market-data.mjs --check && node scripts/build-runtime-data.mjs --check",
    "refresh:data": "node scripts/refresh-market-data.mjs",
    "generate:data": "node scripts/generate-showcase-market.mjs && node scripts/generate-market-depth.mjs",
    "build:data": "node scripts/build-runtime-data.mjs",
    "build:previews": "node scripts/build-card-previews.mjs",
    "build": "npm run check:cli && npm run build:data && npm run build:previews && esbuild src/main.js --bundle --format=esm --target=es2022 --minify --outfile=desk.js",
    "build:site": "node scripts/build-site.mjs",
    "check:cli": "node --check cli/desk && node cli/desk --help",
    "dev": "python3 -m http.server 4173"
  },
  "dependencies": {
    "d3": "7.9.0",
    "motion": "12.42.2"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "geist": "1.7.2",
    "sharp": "^0.35.4"
  }
}
