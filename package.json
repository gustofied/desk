{
  "name": "desk",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://desk.adamsioud.com",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-runtime-data.mjs",
    "build:previews": "node scripts/build-card-previews.mjs",
    "build": "npm run build:data && npm run build:previews && esbuild src/main.js --bundle --format=esm --target=es2022 --minify --outfile=desk.js",
    "dev": "python3 -m http.server 4173"
  },
  "dependencies": {
    "d3": "7.9.0",
    "motion": "12.42.2"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "sharp": "^0.35.4"
  }
}
